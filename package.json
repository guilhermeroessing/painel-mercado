{
  "name": "painel-mercado",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev frontend",
    "build": "next build frontend",
    "servir": "serve frontend/out -l 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test:site && npm run test:pipeline",
    "test:site": "vitest run --passWithNoTests",
    "test:pipeline": "node scripts/testar-pipeline.mjs",
    "coletar": "tsx pipeline/main.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "lightweight-charts": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "serve": "14.2.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
